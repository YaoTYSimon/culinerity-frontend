{
  "name": "culinerity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "npm run test --workspaces --if-present && vitest run && npm run test:server",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:server": "vitest run --config server/vitest.config.ts",
    "server": "npm run start -w @culinerity/server",
    "seed": "npm run seed -w @culinerity/server",
    "build:benchmarks": "node scripts/build-benchmarks.mjs",
    "build:places": "node scripts/build-places.mjs",
    "build:centroids": "node scripts/build-centroids.mjs",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@culinerity/core": "*",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/*",
    "server"
  ],
  "engines": {
    "node": ">=22"
  }
}
